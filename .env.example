DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

AUTH_SECRET="generate-with: npx auth secret"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storage — leave unset to use the local disk fallback (public/uploads)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# WhatsApp (Meta Graph API) — leave unset to no-op order notifications
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
